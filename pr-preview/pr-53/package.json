{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-from-projects.js && node scripts/generate-debugbox.js && node scripts/generate-stats.js && node scripts/generate-contributions.js && node cv/build-pdf.mjs",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc -b && vite build && node scripts/prerender-meta.js",
    "lint": "eslint .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "preview": "vite preview",
    "cv": "node cv/build-pdf.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.5.20",
    "puppeteer": "^25.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "yaml": "^2.9.0"
  }
}
