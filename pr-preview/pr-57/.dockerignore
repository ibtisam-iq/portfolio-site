# Build context exclusions. Keeps the context minimal and prevents secret leakage.

# Version control
.git
.gitignore
.github

# Dependencies, reinstalled inside the container via npm ci
node_modules

# Build output, regenerated by npm run build in the builder stage
dist
build

# Editor / IDE
.vscode
.idea
*.swp
*.swo
.editorconfig

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage
.nyc_output
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
__mocks__
vitest.config.*
jest.config.*

# Docker build files, self-referential and not needed inside the image
# nginx.conf is intentionally absent: COPY in Stage 3 requires it in context
Dockerfile
Dockerfile.*
.dockerignore

# Secrets

# The private CV tree. `COPY public ./public` takes the working tree as it is, so without
# this a local `docker build` after `npm run cv` bakes the unlisted CV into an image that
# gets pushed to a public registry. CI never has the tree, which is not a guarantee.
public/cv/
public/_headers

.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
.secret
.secrets

# Temp / cache
.cache
.tmp
tmp/
temp/
.turbo

# Docs and working files. None is copied by the Dockerfile; excluding them keeps the build
# context small and keeps the planning tree, which is gitignored and local-only, out of it.
README.md
REFERENCE.md
LICENSE
docs/
status.md
plans/

# Not copied by any stage. The chart deploys the image; it is not inside it.
helm/

# The CV source. It is rendered on the host or the runner before `docker build`, and the
# builder stage runs with --ignore-scripts precisely so it is never rendered in here.
cv/

# CI/CD
.github
.gitlab-ci.yml
Jenkinsfile
.circleci
.travis.yml
azure-pipelines.yml
